# Copy to .env.offline and replace every CHANGE_ME value before deployment.
MVI_IMAGE_TAG=CHANGE_ME_GIT_SHA
POSTGRES_DB=uav_search
POSTGRES_USER=mvi
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
CLICKHOUSE_DB=uav_search
CLICKHOUSE_USER=mvi
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
CLICKHOUSE_MAX_MEMORY_BYTES=0
API_TOKEN=CHANGE_ME_API_TOKEN
BIND_HOST=127.0.0.1

# Paths are resolved relative to docker-compose.offline-gpu.yml.
DATA_ROOT=../videos
MODEL_BUNDLE_ROOT=./offline/model-bundle
ARTIFACTS_ROOT=./artifacts
ATTN_IMPL=sdpa
