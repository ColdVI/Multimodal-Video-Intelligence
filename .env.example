# Copy to .env and replace every CHANGE_ME value before deployment.
POSTGRES_DB=uav_search
POSTGRES_USER=mvi
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
CLICKHOUSE_DB=uav_search
CLICKHOUSE_USER=mvi
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD

# Institution profile defaults. docker-compose.benchmark.yml overrides these.
ENABLED_VECTOR_BACKENDS=clickhouse
ENABLED_DIMENSIONS=512
FILTER_EXECUTION_MODE=pushdown
LEGACY_CANDIDATE_LIMIT=100000
EMBEDDING_MODE=synthetic
DECODE_CHUNK_S=300
DECODE_PREFETCH_WINDOWS=8
EMBED_BATCH_SIZE=2
DB_WRITE_BATCH_SIZE=512

BIND_HOST=127.0.0.1
DATA_ROOT=./data
ARTIFACTS_ROOT=./artifacts
MODEL_BUNDLE_ROOT=CHANGE_ME_MODEL_BUNDLE_ROOT
API_URL=http://api:8000
# Optional on loopback; required by preflight when BIND_HOST is non-loopback.
API_TOKEN=

QWEN_REPO_PATH=/opt/Qwen3-VL-Embedding
QWEN_MODEL_PATH=/models/Qwen3-VL-Embedding-2B
QWEN_MODEL_ID=Qwen/Qwen3-VL-Embedding-2B
QWEN_MODEL_REVISION=9f2f7e710d6d81056aa5c0a4f04764fec6bb7bda
QWEN_SOURCE_COMMIT=393e2978d27852b0d0230d6994f37f9c15bed73c
ATTN_IMPL=sdpa

CUDA_IMAGE_TAG=12.1.1-runtime-ubuntu22.04
CLICKHOUSE_MAX_MEMORY_BYTES=
# Compose memory syntax, for example 8g. Empty means no imposed Compose limit.
API_MEMORY_LIMIT=
UI_MEMORY_LIMIT=
MEDIA_MAX_CLIP_S=60
MEDIA_CACHE_MAX_GB=10
MEDIA_CACHE_RETENTION_HOURS=168
MEDIA_H264_CRF=23
MEDIA_URL_TTL_S=300
