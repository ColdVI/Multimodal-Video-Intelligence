  "components": {
    "schemas": {
      "AdaptiveMRL": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "base_dim": {
            "type": "integer",
            "enum": [
              256,
              512
            ],
            "title": "Base Dim",
            "default": 256
          },
          "top_n": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Top N",
            "default": 100
          }
        },
        "type": "object",
        "title": "AdaptiveMRL"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "title": "Query"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "backend": {
            "type": "string",
            "title": "Backend",
            "default": "clickhouse"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy",
            "default": "prefilter"
          },
          "dimension": {
            "type": "integer",
            "enum": [
              2048,
              1024,
              512,
              256
            ],
            "title": "Dimension",
            "default": 512
          },
          "adaptive_mrl": {
            "$ref": "#/components/schemas/AdaptiveMRL"
          },
          "metadata_filters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata Filters"
          },
          "telemetry_filters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Telemetry Filters"
          },
          "pattern": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ],
            "title": "Pattern",
            "default": "A"
          },
          "top_k": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 10
          },
          "repeats": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Repeats",
            "default": 1
          },
          "filter_execution_mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pushdown",
                  "legacy_candidate_ids"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Filter Execution Mode"
          }
        },
        "type": "object",
        "required": [
          "query",
          "dataset_id"
        ],
        "title": "SearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}