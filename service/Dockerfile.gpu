FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/workspace/service
RUN apt-get update && apt-get install -y --no-install-recommends python3.10 python3-pip python3.10-dev git build-essential ffmpeg && rm -rf /var/lib/apt/lists/* && ln -sf /usr/bin/python3.10 /usr/bin/python
WORKDIR /workspace
COPY service/requirements.txt service/requirements-real.txt /tmp/
RUN python -m pip install --no-cache-dir --upgrade pip && python -m pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/requirements-real.txt && python -m pip uninstall -y torchaudio
RUN git clone --depth 1 https://github.com/QwenLM/Qwen3-VL-Embedding.git /opt/Qwen3-VL-Embedding
COPY service /workspace/service
COPY artifacts /workspace/artifacts
CMD ["uvicorn", "app.main:app", "--app-dir", "/workspace/service", "--host", "0.0.0.0", "--port", "8000"]
