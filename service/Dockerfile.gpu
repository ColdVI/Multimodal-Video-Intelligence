FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends python3.10 python3-pip git ffmpeg build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-real.txt ./
RUN python3 -m pip install --no-cache-dir --upgrade pip && python3 -m pip install --no-cache-dir -r requirements-real.txt
RUN git clone --depth 1 https://github.com/QwenLM/Qwen3-VL-Embedding.git /opt/Qwen3-VL-Embedding
RUN hf download Qwen/Qwen3-VL-Embedding-2B --local-dir /opt/Qwen3-VL-Embedding/models/Qwen3-VL-Embedding-2B
RUN python3 -m pip uninstall -y torchaudio
COPY app ./app
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

